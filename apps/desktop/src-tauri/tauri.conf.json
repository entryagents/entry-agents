{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Entry Agents",
  "version": "1.0.0",
  "identifier": "dev.entryagents.desktop",
  "build": {
    "frontendDist": "../resources"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Entry Agents Desktop",
        "label": "main",
        "width": 1380,
        "height": 890,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://entry-agents.dev wss://entry-agents.dev http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
