{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Entry Agents",
  "version": "1.0.0",
  "identifier": "dev.entryagents.desktop",
  "build": {
    "frontendDist": "../resources"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Entry Agents Desktop",
        "label": "main",
        "width": 1380,
        "height": 890,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
