{
  "functions": {
    "app/.well-known/workflow/v1/**": {
      "supportsCancellation": true
    },
    "app/api/chat/route.ts": {
      "supportsCancellation": true
    },
    "app/api/chat/[chatId]/stream/route.ts": {
      "supportsCancellation": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/telegram-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/drive-cleanup",
      "schedule": "0 4 * * *"
    }
  ]
}
